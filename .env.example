# Cartridge runs with none of these set. Every one is optional.

# Port for `npm run dev` and `npm run start`. The npm scripts read it from the shell, not from this file:
#   PORT=4200 npm run dev
PORT=4103

# ---- Manifest generation ----
# auto: use Claude when ANTHROPIC_API_KEY is set, otherwise the offline generator.
# offline: always the deterministic offline generator. anthropic: always Claude.
CARTRIDGE_GENERATOR=auto
ANTHROPIC_API_KEY=
# Model for the Anthropic generator.
CARTRIDGE_MODEL=claude-sonnet-5-5

# ---- Sprite generation ----
# Leave SPRITE_API_KEY empty to use the built-in pixel artist.
# Any image API that speaks the OpenAI images protocol works.
SPRITE_API_KEY=
SPRITE_API_URL=https://api.openai.com/v1/images/generations
SPRITE_IMAGE_MODEL=gpt-image-1
SPRITE_IMAGE_SIZE=1536x1024

# ---- Storage ----
# Where the file store keeps carts. Defaults to .data in the project folder.
CARTRIDGE_DATA_DIR=
# Set both to use a hosted store that speaks the Upstash Redis REST protocol (Vercel KV does).
KV_REST_API_URL=
KV_REST_API_TOKEN=
